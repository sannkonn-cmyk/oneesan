# ------------------------------------------------------------------
# このファイルを .env.local にコピーして書き換えてください。
# .env.local は Git にコミットされません。
# ------------------------------------------------------------------

# ログイン用の合言葉。自分だけが知っている文字列にしてください。
# 空にするとログイン不要になります（自宅PCで自分しか触らない場合のみ推奨）。
APP_PASSWORD=change-me

# AI の呼び出し方法
#   claude-code : PC にインストール済みの Claude Code を使う（Pro/Max のサブスク枠）
#   api         : Anthropic API を直接使う（従量課金。ANTHROPIC_API_KEY が必要）
LLM_PROVIDER=claude-code

# 使うモデル
LLM_MODEL=claude-opus-5

# 思考の深さ。low / medium / high / xhigh / max
# 判定の質そのものが価値なので high を推奨（1件あたり1〜3分）。
# 速さと枠の節約を優先するなら medium にすると体感で半分程度になる。
LLM_EFFORT=high

# LLM_PROVIDER=api のときだけ必要
# ANTHROPIC_API_KEY=sk-ant-...

# Claude Code の実行ファイル名（PATH が通っていれば変更不要）
# CLAUDE_BIN=claude

# 1回の呼び出しのタイムアウト（ミリ秒）
LLM_TIMEOUT_MS=240000

# SQLite ファイルの置き場所
DATABASE_PATH=./data/oneesan.db
